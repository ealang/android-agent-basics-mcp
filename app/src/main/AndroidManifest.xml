<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- "Allow all the time". The foreground/while-in-use grant is withheld
         from a service the system does not consider in use, which is every
         start from a reboot or an app update — and get_location then times out
         silently. This is the documented way to answer regardless, and it is
         what this app is: a server asked for the phone's position while the
         phone is in a pocket. Must be requested on its own, after the
         foreground pair, and the system sends the user to Settings for it. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets us hand timers to the clock app. A normal permission: granted at
         install, no prompt. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Not for drawing anything. Since Android 10 a background app may not
         start an activity, and a foreground service does not earn the right —
         this is the only exemption a normal app can obtain, so without it the
         intent to the clock app is silently dropped. The user must grant it by
         hand in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- All files access, for the webhook pipeline's note destination: notes
         land in an arbitrary top-level folder, which MediaStore
         collections cannot address. Same permission, same reasoning, and the
         same Settings-screen grant as the voice recorder. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- The generic intent tools scan every installed app's automation
         surface — components, filters, permissions. Scoped <queries> entries
         cannot express "everything", so this is the one legitimate use of the
         blanket permission. Play Store policy would object; this app is
         sideloaded and is precisely a device-automation tool. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Android 11+ hides other packages by default. Without these, the Pebble
         companion looks uninstalled and its state provider unreadable. -->
    <queries>
        <package android:name="coredevices.coreapp" />
        <provider android:authorities="com.getpebble.android.provider.basalt" />
        <package android:name="au.com.shiftyjelly.pocketcasts" />
        <!-- The package as well as the authority: starting the gateway is an
             explicit component launch, not a provider call. -->
        <package android:name="com.agentvoicegateway.app" />
        <provider android:authorities="com.agentvoicegateway.app.automation" />
        <package android:name="dev.ealang.voicerecorder" />
        <!-- See every app declaring a MediaBrowserService — the same query
             Android Auto builds its media-app list from. Intent-scoped, so no
             QUERY_ALL_PACKAGES; used by the media probe and, later, generic
             media control. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Phone MCP"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Phone MCP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- specialUse: this is a long-lived local HTTP listener, which none of
             the standard foreground-service types describe. location is also
             declared so get_location works while the app is in the background.

             Declaring a type here only permits it; which ones are actually
             claimed is decided per start in McpService.goForeground, because
             location is while-in-use and is refused to a service started from
             the background. Left implicit, that refusal took down the whole
             service on every reboot and app update. -->
        <service
            android:name=".McpService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|mediaPlayback">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local MCP server for the paired Pebble/agent to call" />
        </service>

        <!-- Empty listener; enabling it in Settings > Notification access is
             what authorizes MediaSessionManager.getActiveSessions, which is the
             only route into Pocket Casts' media session that release builds
             don't block. We never read notifications. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
