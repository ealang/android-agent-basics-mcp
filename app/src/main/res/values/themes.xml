<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform's DayNight theme without its action bar. There is no
         public NoActionBar variant of Theme.DeviceDefault.DayNight, so this
         is that: the page draws its own title. -->
    <style name="Theme.PuckMcp" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
